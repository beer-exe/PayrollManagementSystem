<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<!-- FrameworkReference cấp quyền truy cập SignalR, Authorization và ASP.NET Core types
		     cho class library (Microsoft.NET.Sdk) mà không cần NuGet package cũ deprecated -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="MailKit" Version="4.17.0" />
